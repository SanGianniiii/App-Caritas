rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data; }
    function ok() { return request.auth != null && exists(/databases/$(database)/documents/utenti/$(request.auth.uid)) && me().attivo == true; }
    function P() { return {
      'persone': {'r': ['admin','coordinatore','frontoffice','ascolto','magazzino'], 'w': ['admin','coordinatore','frontoffice','ascolto']},
      'richieste': {'r': ['admin','coordinatore','frontoffice','ascolto'], 'w': ['admin','coordinatore','frontoffice','ascolto']},
      'appuntamenti': {'r': ['admin','coordinatore','frontoffice','ascolto'], 'w': ['admin','coordinatore','frontoffice','ascolto']},
      'comunicazioni': {'r': ['admin','coordinatore','frontoffice','ascolto'], 'w': ['admin','coordinatore','frontoffice','ascolto']},
      'colloqui': {'r': ['admin','coordinatore','ascolto'], 'w': ['admin','coordinatore','ascolto']},
      'articoli': {'r': ['admin','coordinatore','magazzino'], 'w': ['admin','coordinatore','magazzino']},
      'movimenti': {'r': ['admin','coordinatore','magazzino'], 'w': ['admin','coordinatore','magazzino']},
      'distribuzioni': {'r': ['admin','coordinatore','magazzino'], 'w': ['admin','coordinatore','magazzino']},
      'inventari': {'r': ['admin','coordinatore','magazzino'], 'w': ['admin','coordinatore','magazzino']},
      'volontari': {'r': ['admin','coordinatore','respvol','volontario'], 'w': ['admin','coordinatore','respvol']},
      'turni': {'r': ['admin','coordinatore','respvol','volontario'], 'w': ['admin','coordinatore','respvol']},
      'formazione': {'r': ['admin','coordinatore','respvol'], 'w': ['admin','coordinatore','respvol']},
      'donatori': {'r': ['admin','coordinatore','respdon'], 'w': ['admin','coordinatore','respdon']},
      'donazioni': {'r': ['admin','coordinatore','respdon'], 'w': ['admin','coordinatore','respdon']},
      'eventi': {'r': ['admin','coordinatore','respdon'], 'w': ['admin','coordinatore','respdon']},
      'enti': {'r': ['admin','coordinatore','ascolto'], 'w': ['admin','coordinatore','ascolto']},
      'invii': {'r': ['admin','coordinatore','ascolto'], 'w': ['admin','coordinatore','ascolto']},
      'riunioni': {'r': ['admin','coordinatore','parroco'], 'w': ['admin','coordinatore','parroco']},
      'azioni': {'r': ['admin','coordinatore','parroco'], 'w': ['admin','coordinatore','parroco']}
    }; }
    match /utenti/{id} {
      allow read: if ok();
      allow create, delete: if ok() && me().ruolo == 'admin';
      allow update: if ok() && (me().ruolo == 'admin' || (request.auth.uid == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange','modificatoIl','modificatoDa'])));
    }
    match /audit/{id} {
      allow create: if ok();
      allow read: if ok() && me().ruolo in ['admin','coordinatore','parroco'];
    }
    match /{coll}/{id} {
      allow read: if ok() && (coll in P()) && me().ruolo in P()[coll].r;
      allow write: if ok() && (coll in P()) && me().ruolo in P()[coll].w;
    }
  }
}
